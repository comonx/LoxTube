<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube-style floating Network Offline / Online status banner -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_network_banner"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|bottom"
    android:background="@drawable/bg_mobile_network_banner"
    android:clickable="true"
    android:focusable="false"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="16dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/mobile_network_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="9dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_network_offline" />

    <TextView
        android:id="@+id/mobile_network_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="কোনো ইন্টারনেট সংযোগ নেই"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/mobile_network_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="ডাউনলোডে যান"
        android:textColor="#3EA6FF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
