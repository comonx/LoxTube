<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-grid video card, YouTube-style: a flat (no box, no elevation) cell whose thumbnail is
  clipped to rounded corners by the inner MaterialCardView, with title/channel text sitting
  directly on the window background. The outer card is only the click/ripple container.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/video_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Edge-to-edge full-width video thumbnail (0 margin, 0 corner radius) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/video_thumbnail_frame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="@color/mobile_color_placeholder"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/video_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/video_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_video_badge"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="12:34" />

            <ProgressBar
                android:id="@+id/video_watch_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:max="100"
                android:progressBackgroundTint="@color/mobile_color_progress_track"
                android:progressTint="@color/mobile_color_progress"
                android:visibility="gone"
                tools:progress="40"
                tools:visibility="visible" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Channel avatar box (squircle / rounded rectangle box, not circle) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/video_channel_avatar_box"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/mobile_color_placeholder"
            app:strokeWidth="0.8dp"
            app:strokeColor="#22888888"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/video_thumbnail_frame">

            <ImageView
                android:id="@+id/video_channel_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_watch_channel_placeholder" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/video_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2sp"
            android:maxLines="2"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@+id/video_overflow"
            app:layout_constraintStart_toEndOf="@id/video_channel_avatar_box"
            app:layout_constraintTop_toBottomOf="@id/video_thumbnail_frame"
            tools:text="A great video title that may wrap to two lines" />

        <!-- Overflow menu -->
        <ImageButton
            android:id="@+id/video_overflow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_player_more"
            android:padding="10dp"
            android:src="@drawable/ic_mobile_more_vert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/video_thumbnail_frame" />

        <!-- Meta line: "Channel · 1.2M views · 3 weeks ago" -->
        <TextView
            android:id="@+id/video_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/video_overflow"
            app:layout_constraintStart_toEndOf="@id/video_channel_avatar_box"
            app:layout_constraintTop_toBottomOf="@id/video_title"
            tools:text="Channel name · 1.2M views · 3 weeks ago" />

        <!-- Subtle Bottom Divider / Border Separator -->
        <View
            android:id="@+id/video_card_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/mobile_color_divider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/video_meta" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
